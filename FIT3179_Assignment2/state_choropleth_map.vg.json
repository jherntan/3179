{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "National Park Land Area & Primary Recreational Activities"
  },
  "width": 600,
  "height": 400,
  "projection": {
    "type": "mercator",
    "center": [134.0, -28.0],
    "scale": 700
  },
  "layer": [
    {
      "data": {
        "url": "https://raw.githubusercontent.com/vega/vega-datasets/main/data/world-110m.json",
        "format": { "type": "topojson", "feature": "countries" }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#f8f9fa",
        "stroke": "#ced4da",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "url": "data/australian_national_parks.csv"
      },
      "mark": {
        "type": "point",
        "filled": true,
        "shape": "diamond",
        "stroke": "#ffffff",
        "strokeWidth": 0.8
      },
      "encoding": {
        "longitude": { "field": "longitude", "type": "quantitative" },
        "latitude": { "field": "latitude", "type": "quantitative" },
        "size": {
          "field": "area_hectares",
          "type": "quantitative",
          "title": "Park Area (Hectares)",
          "scale": { "range": [50, 800] }
        },
        "color": {
          "field": "primary_activity",
          "type": "nominal",
          "title": "Primary Activity",
          "scale": { "scheme": "category10" }
        },
        "tooltip": [
          { "field": "park_name", "type": "nominal", "title": "National Park" },
          { "field": "state", "type": "nominal", "title": "State" },
          { "field": "area_hectares", "type": "quantitative", "title": "Area (Hectares)", "format": "," },
          { "field": "primary_activity", "type": "nominal", "title": "Primary Activity" }
        ]
      }
    }
  ]
}