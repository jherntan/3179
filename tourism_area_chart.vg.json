{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": { "text": "Proportional Growth of Tourism Trips Across States" },
  "width": 600,
  "height": 350,
  "data": {
    "url": "data/tourism.csv"
  },
  "mark": "area",
  "encoding": {
    "x": {
      "field": "Quarter",
      "type": "temporal",
      "title": "Quarter"
    },
    "y": {
      "aggregate": "sum",
      "field": "Trips",
      "type": "quantitative",
      "title": "Total Trips (Thousands)",
      "stack": "normalize"
    },
    "color": {
      "field": "State",
      "type": "nominal",
      "title": "State"
    },
    "tooltip": [
      { "field": "Quarter", "type": "temporal", "title": "Date", "format": "%b %Y" },
      { "field": "State", "type": "nominal", "title": "State" },
      { "aggregate": "sum", "field": "Trips", "type": "quantitative", "title": "Total Trips", "format": ",.0f" }
    ]
  }
}