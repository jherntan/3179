{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": { "text": "Park Size (Hectares) vs. Annual Visitors" },
  "width": 600,
  "height": 350,
  "data": {
    "url": "data/australian_national_parks.csv"
  },
  "mark": {
    "type": "point",
    "filled": true,
    "size": 100
  },
  "encoding": {
    "x": {
      "field": "area_hectares",
      "type": "quantitative",
      "scale": { "type": "log" },
      "title": "Park Area (Hectares - Log Scale)"
    },
    "y": {
      "field": "annual_visitors",
      "type": "quantitative",
      "scale": { "type": "log" },
      "title": "Annual Visitors (Log Scale)"
    },
    "color": {
      "field": "state",
      "type": "nominal",
      "title": "State"
    },
    "tooltip": [
      { "field": "park_name", "type": "nominal", "title": "Park Name" },
      { "field": "area_hectares", "type": "quantitative", "title": "Area (ha)", "format": "," },
      { "field": "annual_visitors", "type": "quantitative", "title": "Visitors", "format": "," }
    ]
  }
}
