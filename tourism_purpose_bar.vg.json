{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": { "text": "Total Tourism Trips by Purpose across States" },
  "width": 550,
  "height": 350,
  "data": {
    "url": "data/tourism.csv"
  },
  "mark": "bar",
  "encoding": {
    "x": {
      "field": "State",
      "type": "nominal",
      "title": "State"
    },
    "y": {
      "aggregate": "sum",
      "field": "Trips",
      "type": "quantitative",
      "title": "Total Trips (Thousands)"
    },
    "color": {
      "field": "Purpose",
      "type": "nominal",    
      "title": "Trip Purpose"
    }
  }
}